DATABASE_URL=mysql://<user>:<password>@localhost:3306/<database>
AUTH_SESSION_SECRET=<at-least-32-random-bytes>
AUTH_FINGERPRINT_SECRET=<different-at-least-32-random-bytes>
APP_ORIGIN=http://localhost:3005
TRUST_PROXY=false
ENABLE_DEV_STAFF_SWITCHER=false
BOOTSTRAP_OWNER_PASSWORD=<set-only-while-running-bootstrap>
BACKUP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
BACKUP_DIRECTORY=backups
BACKUP_RESTORE_ENABLED=false
NOTIFICATION_PROVIDER_MODE=disabled
# ใช้ simulate เพื่อทดสอบ state โดยไม่ส่งออก หรือ live เมื่อกำหนดช่องทางจริงครบแล้ว
# NOTIFICATION_SMS_WEBHOOK_URL=https://sms-provider.example/send
# NOTIFICATION_SMS_WEBHOOK_TOKEN=<secret>
# NOTIFICATION_LINE_ACCESS_TOKEN=<secret>
# NOTIFICATION_EMAIL_FROM=fitness@example.com
# NOTIFICATION_SMTP_HOST=smtp.example.com
# NOTIFICATION_SMTP_PORT=465
# NOTIFICATION_SMTP_SECURE=true
# NOTIFICATION_SMTP_USERNAME=<username>
# NOTIFICATION_SMTP_PASSWORD=<secret>
# MYSQLDUMP_BINARY=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# MYSQL_BINARY=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe
